<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Widget.CostControl.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@drawable/bg_toolbar_gradient</item>
        <item name="android:elevation">@dimen/toolbar_elevation</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/textColorMutedOnPrimary</item>
        <item name="android:theme">@style/ThemeOverlay.CostControl.Toolbar</item>
    </style>

    <style name="ThemeOverlay.CostControl.Toolbar" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="Widget.CostControl.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusTopEnd">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomStart">@dimen/radius_md</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/radius_md</item>
        <item name="boxStrokeColor">@color/input_stroke_color</item>
        <item name="hintTextColor">@color/colorAccent</item>
        <item name="startIconTint">@color/colorAccent</item>
    </style>

    <style name="Widget.CostControl.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">@dimen/radius_md</item>
        <item name="android:minHeight">56dp</item>
        <item name="backgroundTint">@color/colorPrimary</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.CostControl.Button.Accent" parent="Widget.CostControl.Button.Primary">
        <item name="backgroundTint">@color/colorAccent</item>
    </style>

    <style name="Widget.CostControl.Button.Danger" parent="Widget.CostControl.Button.Primary">
        <item name="backgroundTint">@color/colorDelete</item>
    </style>

    <style name="Widget.CostControl.Button.Outlined.Edit" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="strokeColor">@color/colorEdit</item>
        <item name="android:textColor">@color/colorEdit</item>
        <item name="iconTint">@color/colorEdit</item>
        <item name="rippleColor">@color/colorEditSoft</item>
    </style>

    <style name="Widget.CostControl.Button.Outlined.Delete" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">@dimen/radius_sm</item>
        <item name="strokeColor">@color/colorDelete</item>
        <item name="android:textColor">@color/colorDelete</item>
        <item name="iconTint">@color/colorDelete</item>
        <item name="rippleColor">@color/colorDeleteSoft</item>
    </style>

    <style name="Widget.CostControl.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/radius_lg</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/cardBackgroundColor</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/strokeLight</item>
    </style>

    <style name="TextAppearance.CostControl.Headline" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CostControl.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/textColorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.CostControl.Body" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/textColorSecondary</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

</resources>
